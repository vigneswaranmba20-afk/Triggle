      },
      "title": {
        "en": "Find a smaller-division remainder"
      },
      "q": {
        "en": "A positive integer when divided by 88 gives the remainder 61. What will be the remainder when the same number is divided by 11?"
      },
      "steps": [
        {
          "en": "Use the division algorithm for the original number n. Its quotient k is a nonnegative integer.",
          "eq": "n = 88k + 61"
        },
        {
          "en": "Both 88 and the largest multiple of 11 below 61 can be grouped as multiples of 11.",
          "eq": "88 = 11 × 8; 61 = 11 × 5 + 6"
        },
        {
          "en": "Rewrite n as a multiple of 11 plus a valid remainder.",
          "eq": "n = 11(8k+5) + 6; 0 ≤ 6 < 11"
        }
      ],
      "answer": "6.",
      "kind": "textbook",
      "source": "https://drive.google.com/file/d/13XJXdPhuGqU3BG3BPrsmzZwUUFOuH6Of/view",
      "reference": "TN SCERT Standard Ten Mathematics; 2025 revised English edition; Chapter 2, Exercise 2.1 Q9; printed p. 43, PDF p. 49.",
      "edition": "2025",
      "translationReview": "pending"
    },
    {
      "id": "c10-2-ex2-1-q10",
      "classNum": 10,
      "chapter": "2",
      "exercise": "2.1",
      "topic": {
        "en": "Numbers and Sequences"
      },
      "label": {
        "en": "Exercise 2.1 · Q10",
        "ta": "Exercise 2.1 · Q10 (English only; Tamil pending)"
      },
      "title": {
        "en": "Consecutive integers are coprime"
      },
      "q": {
        "en": "Prove that two consecutive positive integers are always coprime."
      },
      "steps": [
        {
          "en": "Let the consecutive positive integers be n and n+1. Let d be their greatest positive common divisor.",
          "eq": "d divides n and d divides n+1"
        },
        {
          "en": "A common divisor divides the difference of the two numbers.",
          "eq": "d divides (n+1)−n = 1"
        },
        {
