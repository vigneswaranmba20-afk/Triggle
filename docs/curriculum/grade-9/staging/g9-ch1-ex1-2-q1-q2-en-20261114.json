          "math": {
            "latex": "n\\in\\{0,1,2,3,4\\}",
            "display": true,
            "fallback": "n ∈ {0, 1, 2, 3, 4}"
          }
        },
        {
          "en": "Substitute each allowed n; there are five distinct results.",
          "eq": "P = {2, 5, 8, 11, 14}; n(P) = 5",
          "math": {
            "latex": "\\begin{aligned}P&=\\{2,5,8,11,14\\}\\\\n(P)&=5\\end{aligned}",
            "display": true,
            "fallback": "P = {2, 5, 8, 11, 14}; n(P) = 5"
          }
        }
