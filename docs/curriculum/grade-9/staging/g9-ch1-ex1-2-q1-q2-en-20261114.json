      },
      "q": {
        "en": "2. Identify the following sets as finite or infinite.\n(iv) B = {x : x²−5x+6 = 0, x∈N}"
      },
      "steps": [
        {
          "en": "Factor the polynomial into two linear factors.",
          "eq": "x² − 5x + 6 = (x − 2)(x − 3)",
          "math": {
            "latex": "x^2-5x+6=(x-2)(x-3)",
            "display": true,
            "fallback": "x² − 5x + 6 = (x − 2)(x − 3)"
          }
        },
        {
          "en": "A zero product means one of its factors is zero.",
          "eq": "x = 2 or x = 3",
          "math": {
            "latex": "x=2\\quad\\text{or}\\quad x=3",
            "display": true,
            "fallback": "x = 2 or x = 3"
          }
        },
        {
          "en": "Both solutions are natural numbers, and there are exactly two members.",
          "eq": "B = {2, 3}; n(B) = 2",
          "math": {
            "latex": "\\begin{aligned}B&=\\{2,3\\}\\\\n(B)&=2\\end{aligned}",
            "display": true,
            "fallback": "B = {2, 3}; n(B) = 2"
          }
        }
      ],
      "answer": "Finite (B = {2, 3})",
      "answerMath": {
        "latex": "B=\\{2,3\\}\\quad\\text{finite}",
        "display": true,
