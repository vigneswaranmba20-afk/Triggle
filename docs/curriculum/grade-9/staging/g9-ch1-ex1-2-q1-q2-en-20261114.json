      "q": {
        "en": "1. Find the cardinal number of the following sets.\n(iii) Q = {y : y = 4/(3n), n∈N and 2 < n ≤5}"
      },
      "steps": [
        {
          "en": "Read the printed stacked fraction correctly: four divided by the full denominator 3n.",
          "eq": "y = 4/(3n)",
          "math": {
            "latex": "y=\\dfrac{4}{3n}",
            "display": true,
            "fallback": "y = 4/(3n)"
          }
        },
        {
          "en": "Only natural numbers 3, 4 and 5 satisfy the interval.",
          "eq": "2 < n ≤ 5 ⇒ n ∈ {3, 4, 5}",
          "math": {
            "latex": "2<n\\le5\\Rightarrow n\\in\\{3,4,5\\}",
            "display": true,
            "fallback": "2 < n ≤ 5 ⇒ n ∈ {3, 4, 5}"
          }
        },
        {
          "en": "Substitute and simplify: each rational number is different.",
          "eq": "Q = {4/9, 1/3, 4/15}",
          "math": {
            "latex": "Q=\\left\\{\\dfrac{4}{9},\\dfrac{1}{3},\\dfrac{4}{15}\\right\\}",
            "display": true,
            "fallback": "Q = {4/9, 1/3, 4/15}"
          }
        },
        {
          "en": "Count the three distinct members.",
          "eq": "n(Q) = 3",
          "math": {
            "latex": "n(Q)=3",
            "display": true,
            "fallback": "n(Q) = 3"
          }
        }
      ],
      "answer": "n(Q) = 3",
