            "latex": "R=\\{-5,-4,-3,-2,-1,0,1,2,3,4\\}",
            "display": true,
            "fallback": "R = {−5,−4,−3,−2,−1,0,1,2,3,4}"
          }
        },
        {
          "en": "Counting inclusively from −5 through 4 gives ten integers.",
          "eq": "n(R) = 4 − (−5) + 1 = 10",
          "math": {
            "latex": "n(R)=4-(-5)+1=10",
            "display": true,
            "fallback": "n(R) = 4 − (−5) + 1 = 10"
          }
        }
