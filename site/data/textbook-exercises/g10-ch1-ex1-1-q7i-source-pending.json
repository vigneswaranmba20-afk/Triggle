    {
      "explanation": "List natural numbers below eight.",
      "equation": "A={1,2,3,4,5,6,7}"
    },
    {
      "explanation": "List primes below eight. A prime has exactly two positive divisors.",
      "equation": "B={2,3,5,7}"
    },
    {
      "explanation": "Two is the only even prime.",
      "equation": "C={2}"
    },
    {
      "explanation": "Every member of B also belongs to A.",
      "equation": "A∩B={2,3,5,7}"
    },
    {
      "explanation": "Pair each member of A∩B with the only member of C.",
      "equation": "(A∩B)×C={(2,2),(3,2),(5,2),(7,2)}"
    },
    {
      "explanation": "A×C has seven pairs, while B×C has four. Their intersection keeps precisely the four common pairs.",
      "equation": "(A×C)∩(B×C)={(2,2),(3,2),(5,2),(7,2)}"
    },
    {
      "explanation": "The two enumerated sets agree, establishing the provisional identity for these sets.",
      "equation": "(A∩B)×C=(A×C)∩(B×C)"
