  "discrepancies": [
    {
      "question": 7,
      "issue": "The phrase smallest rational number is evaluated among the offered multipliers. The solution explicitly applies the MCQ scope."
    },
    {
      "question": 11,
      "issue": "Choice 1 uses square root colloquially for the two roots of x²=25. Choice 4 is false under the conventional principal radical notation. The working distinguishes the two senses."
    },
    {
      "question": 15,
      "issue": "The Tamil printing duplicates the terminal equals sign. The student card uses one equals sign without changing the expression or choices."
    },
