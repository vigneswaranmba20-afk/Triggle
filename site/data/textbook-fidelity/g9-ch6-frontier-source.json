      {
        "id": "exercise-6-1-q5",
        "originalRecord": {
          "id": "exercise-6-1-q5",
          "ref": "Exercise 6.1 · Q5",
          "type": "6.1",
          "title": "Ratios in terms of x",
          "prompt": "If cos A = [[2x|1 + x²]], find sin A and tan A. Assume A is acute, so x > 0 and x ≠ 1.",
          "steps": [
            {
              "why": "In a right triangle, take adjacent = 2x and hypotenuse = 1+x².",
              "eq": "cos A = [[2x|1+x²]]"
            },
            {
              "why": "Calculate the opposite side using Pythagoras. A length cannot be negative.",
              "eq": "√((1+x²)² − (2x)²) = √((1−x²)²) = |1−x²|"
            },
            {
              "why": "Sine compares opposite and hypotenuse.",
              "eq": "sin A = [[∣1−x²∣|1+x²]]"
            },
            {
              "why": "Tangent compares opposite and adjacent.",
              "eq": "tan A = [[∣1−x²∣|2x]]"
            },
            {
              "why": "For 0<x<1, remove the absolute bars as 1−x². For x>1, use x²−1.",
              "eq": "0<x<1: sin A = [[1−x²|1+x²]] ; tan A = [[1−x²|2x]]"
            }
          ],
          "demo": {
            "kind": "symbolic-x"
          },
          "page": 6,
          "final": "sin A = [[∣1−x²∣|1+x²]] ; tan A = [[∣1−x²∣|2x]]",
          "promptTa": "cos A = [[2x|1 + x²]] எனில் sin A, tan A-ஐ காண்க. A ஒரு குறுங்கோணம்; x > 0, x ≠ 1 என எடுத்துக்கொள்க.",
          "stepsTa": [
