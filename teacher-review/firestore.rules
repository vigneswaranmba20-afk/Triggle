rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function approvedTeacher() {
      return signedGoogle()
        && exists(/databases/$(database)/documents/teacherAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/teacherAccess/$(request.auth.uid)).data.role == 'reviewer';
    }
    function validReview() {
      return request.resource.data.keys().hasOnly([
          'questionId', 'grade', 'chapter', 'exercise', 'decision',
          'note', 'reviewerUid', 'recordSha256', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'questionId', 'grade', 'chapter', 'exercise', 'decision',
          'note', 'reviewerUid', 'recordSha256', 'createdAt'
        ])
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() > 0
        && request.resource.data.questionId.size() <= 150
        && request.resource.data.grade in [9, 10, 11, 12]
        && request.resource.data.chapter is string
        && request.resource.data.chapter.size() > 0
        && request.resource.data.chapter.size() <= 3
        && request.resource.data.exercise is string
        && request.resource.data.exercise.size() <= 32
        && request.resource.data.decision in ['approved', 'needs-correction', 'pending']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500
        && request.resource.data.recordSha256 is string
        && request.resource.data.recordSha256.matches('^[0-9a-f]{64}$')
        && request.resource.data.createdAt == request.time;
    }

    // The owner creates teacherAccess/{FirebaseAuthUID} through the
    // Firebase Console. Clients can check only their own role record, and
    // can never create, edit, list or delete access grants.
    match /teacherAccess/{teacherUid} {
      allow get: if signedGoogle() && request.auth.uid == teacherUid;
      allow list, create, update, delete: if false;
    }

    match /teacherReviewEvents/{eventId} {
      allow get, list: if approvedTeacher();
      allow create: if approvedTeacher() && validReview();
      allow update, delete: if false;
    }

    // Use a dedicated Firestore project for reviews. This rule denies
    // every other collection, including anything a student might guess.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
